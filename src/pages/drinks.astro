---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import "../styles/drinks.css";

const allBeers = await getCollection("beers");
const allCiders = await getCollection("ciders");

const beers = allBeers
  .filter((item) => item.data.status === "confirmed")
  .sort((a, b) => (a.data.sortOrder ?? 9999) - (b.data.sortOrder ?? 9999));

const ciders = allCiders
  .filter((item) => item.data.status === "confirmed")
  .sort((a, b) => (a.data.sortOrder ?? 9999) - (b.data.sortOrder ?? 9999));
---

<BaseLayout
  title="Drinks | Blewbury Beer Festival 2026"
  description="Explore the confirmed beer and cider line-up for Blewbury Beer Festival 2026, with wine and gin selections coming soon."
>
  <Header />

  <main class="drinks-page">
    <section class="drinks-hero">
      <div class="container">
        <p class="eyebrow eyebrow-gold">2026 DRINKS</p>
        <h1>What's on the bar?</h1>
        <p class="drinks-hero-copy">
          Beer, cider, wine and gin at Blewbury Village Hall on Saturday 3 October.
          Here's what we can confirm so far.
        </p>
      </div>
    </section>

    <section class="drinks-section beer-section">
      <div class="container">
        <div class="drinks-section-heading">
          <div>
            <p class="eyebrow">BEER</p>
            <h2>{beers.length} beers confirmed.</h2>
          </div>
          <p>
            From crisp pale ales and pilsner through to bitter, porter and stout.
            The line-up is designed to give you plenty to explore without making
            choosing your next pint feel like homework.
          </p>
        </div>

        <div class="drink-grid">
          {beers.map((beer) => (
            <article class="drink-card">
              <div class="drink-art">
                {beer.data.graphic ? (
                  <img
                    src={beer.data.graphic}
                    alt={`${beer.data.name} artwork`}
                    loading="lazy"
                  />
                ) : (
                  <span aria-hidden="true">{beer.data.name.charAt(0)}</span>
                )}
              </div>

              <div class="drink-card-content">
                <p class="drink-maker">{beer.data.brewery}</p>
                <h3>{beer.data.name}</h3>

                {beer.data.description && (
                  <p class="drink-description">{beer.data.description}</p>
                )}

                <div class="drink-meta">
                  <span>{beer.data.style}</span>
                  <strong>{beer.data.abv.toFixed(1)}%</strong>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="drinks-section cider-section">
      <div class="container">
        <div class="drinks-section-heading cider-heading">
          <div>
            <p class="eyebrow eyebrow-gold">CIDER</p>
            <h2>Something for the cider drinkers.</h2>
          </div>
          <p>{ciders.length} ciders are confirmed so far.</p>
        </div>

        <div class="cider-grid">
          {ciders.map((cider) => (
            <article class="cider-card">
              <div>
                <p class="drink-maker cider-maker">{cider.data.producer}</p>
                <h3>{cider.data.name}</h3>
                {cider.data.description && (
                  <p class="cider-description">{cider.data.description}</p>
                )}
              </div>

              <div class="cider-meta">
                <span>{cider.data.style}</span>
                <strong>{cider.data.abv.toFixed(1)}%</strong>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="coming-drinks">
      <div class="container coming-drinks-grid">
        <article class="coming-drink-card wine-card">
          <p class="eyebrow">WINE</p>
          <h2>Wine selection coming soon.</h2>
          <p>
            We're still finalising the 2026 wine list. We'll add the confirmed
            bottles here as soon as the selection is agreed.
          </p>
          <span class="coming-tag">Selection in progress</span>
        </article>

        <article class="coming-drink-card gin-card">
          <p class="eyebrow">GIN</p>
          <h2>The gin bar is taking shape.</h2>
          <p>
            The gin range hasn't been confirmed yet, but it will be. Check back
            as we get closer to festival day.
          </p>
          <span class="coming-tag">Selection in progress</span>
        </article>
      </div>
    </section>

    <section class="drinks-disclaimer">
      <div class="container drinks-disclaimer-inner">
        <p class="eyebrow eyebrow-dark">GOOD TO KNOW</p>
        <p>
          Festival drinks can occasionally change before the day. We'll keep
          this page up to date if the planned line-up changes.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
