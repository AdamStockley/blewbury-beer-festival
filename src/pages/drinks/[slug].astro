---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/global.css";
import "../../styles/drink-detail.css";

export async function getStaticPaths() {
  const groups = [
    ["beer", await getCollection("beers")],
    ["cider", await getCollection("ciders")],
    ["wine", await getCollection("wines")],
    ["gin", await getCollection("gins")],
  ];

  return groups.flatMap(([type, entries]) =>
    entries
      .filter((entry) => entry.data.status === "confirmed")
      .map((entry) => ({
        params: { slug: entry.id },
        props: { entry, type },
      }))
  );
}

const { entry, type } = Astro.props;
const producer = type === "beer" ? entry.data.brewery : entry.data.producer;
---

<BaseLayout
  title={`${entry.data.name} | Drinks | Blewbury Beer Festival 2026`}
  description={entry.data.description ?? `${entry.data.name} at Blewbury Beer Festival 2026.`}
>
  <Header />

  <main class="drink-detail-page">
    <section class="drink-detail-hero">
      <div class="container drink-detail-grid">
        <div class="drink-detail-art">
          {entry.data.graphic ? (
            <img src={entry.data.graphic} alt={`${entry.data.name} artwork`} />
          ) : (
            <div class="drink-detail-placeholder" aria-hidden="true">
              {entry.data.name.charAt(0)}
            </div>
          )}
        </div>

        <div class="drink-detail-copy">
          <p class="eyebrow eyebrow-gold">{String(type).toUpperCase()}</p>
          <p class="drink-detail-producer">{producer}</p>
          <h1>{entry.data.name}</h1>

          <div class="drink-detail-meta">
            {entry.data.style && <span>{entry.data.style}</span>}
            {entry.data.abv !== undefined && <strong>{entry.data.abv.toFixed(1)}%</strong>}
          </div>

          {entry.data.description && (
            <p class="drink-detail-description">{entry.data.description}</p>
          )}

          {entry.data.flavourTags?.length > 0 && (
            <div class="flavour-tags detail-tags">
              {entry.data.flavourTags.map((tag) => <span>{tag}</span>)}
            </div>
          )}

          <div class="detail-tasting-actions" aria-label={`Rate ${entry.data.name}`}>
            <button
              class="detail-tasting-button detail-tasting-button--like"
              type="button"
              data-tasting-like={entry.id}
              aria-label={`I like ${entry.data.name}`}
              aria-pressed="false"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M7 10v10H4V10h3Zm3 10V9.5l3.6-5.1a1.5 1.5 0 0 1 2.7 1.1L16 10h3.2a2 2 0 0 1 2 2.4l-1.1 5.5A2.6 2.6 0 0 1 17.6 20H10Z" />
              </svg>
              <span>I liked this</span>
            </button>

            <button
              class="detail-tasting-button detail-tasting-button--dislike"
              type="button"
              data-tasting-dislike={entry.id}
              aria-label={`${entry.data.name} is not for me`}
              aria-pressed="false"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M7 14V4H4v10h3Zm3-10v10.5l3.6 5.1a1.5 1.5 0 0 0 2.7-1.1L16 14h3.2a2 2 0 0 0 2-2.4l-1.1-5.5A2.6 2.6 0 0 0 17.6 4H10Z" />
              </svg>
              <span>Not for me</span>
            </button>
          </div>
        </div>
      </div>
    </section>

    <section class="drink-detail-info">
      <div class="container drink-info-grid">
        <div>
          <p class="eyebrow">MADE BY</p>
          <h2>{producer}</h2>

          {entry.data.producerTown && <p>{entry.data.producerTown}</p>}

          {entry.data.producerWebsite && (
            <p>
              <a href={entry.data.producerWebsite} target="_blank" rel="noopener noreferrer">
                Visit producer website ↗
              </a>
            </p>
          )}
        </div>

        <div class="drink-qr-note">
          <p class="eyebrow">AT THE FESTIVAL</p>
          <h3>Found this from a QR code?</h3>
          <p>
            This page is designed to work as your pocket tasting guide. Mark
            each drink as liked or not for you and your Festival Passport will
            remember your choices as you explore the bar.
          </p>
          <a href="/drinks">← Back to all drinks</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script is:inline>
    (() => {
      const STORAGE_KEY = "bbf-2026-drink-ratings";

      const likeButton = document.querySelector("[data-tasting-like]");
      const dislikeButton = document.querySelector("[data-tasting-dislike]");

      if (!likeButton || !dislikeButton) return;

      const id = likeButton.dataset.tastingLike;

      const loadRatings = () => {
        try {
          const parsed = JSON.parse(localStorage.getItem(STORAGE_KEY) || "{}");
          return parsed && typeof parsed === "object" ? parsed : {};
        } catch {
          return {};
        }
      };

      const saveRatings = (ratings) => {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(ratings));
      };

      const renderRating = () => {
        const ratings = loadRatings();
        likeButton.setAttribute(
          "aria-pressed",
          String(ratings[id] === "liked")
        );
        dislikeButton.setAttribute(
          "aria-pressed",
          String(ratings[id] === "disliked")
        );
      };

      const setRating = (nextState) => {
        const ratings = loadRatings();

        if (ratings[id] === nextState) {
          delete ratings[id];
        } else {
          ratings[id] = nextState;
        }

        saveRatings(ratings);
        renderRating();
      };

      likeButton.addEventListener("click", () => {
        setRating("liked");
      });

      dislikeButton.addEventListener("click", () => {
        setRating("disliked");
      });

      renderRating();
    })();
  </script>
</BaseLayout>
