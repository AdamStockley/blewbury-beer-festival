---
const features = [
  {
    kicker: "LIVE MUSIC",
    title: "Who played?",
    text: "Look back at the performers who filled the afternoon and evening with live music.",
    href: "/entertainment",
    link: "See the 2026 line-up",
  },
  {
    kicker: "FOOD",
    title: "Festival food.",
    text: "See the food served by Blewbury School PTA at the 2026 festival.",
    href: "/food",
    link: "See the food",
  },
  {
    kicker: "BARREL SPONSORS",
    title: "Meet our supporters.",
    text: "Meet the local businesses whose generous barrel sponsorship helped make the 2026 festival possible.",
    href: "/sponsors",
    link: "Meet our sponsors",
  },
];
---

<section class="home-features">
  <div class="container">
    <div class="home-feature-grid">
      {features.map((feature) => (
        <a class="home-feature-card" href={feature.href}>
          <p class="eyebrow">{feature.kicker}</p>
          <h2>{feature.title}</h2>
          <p>{feature.text}</p>
          <span>{feature.link} →</span>
        </a>
      ))}
    </div>
  </div>
</section>
