---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---

<BaseLayout title="Beer, Cider & Drinks | Blewbury Beer Festival 2026">
  <Header />

  <main class="placeholder">
    <div class="container">
      <div class="placeholder-box">
        <p class="eyebrow">2026 Festival</p>
        <h1>Beer, Cider & Drinks</h1>
        <p>We're currently selecting the drinks for the 2026 festival. Breweries, beers, ciders and other drinks will appear here as they're confirmed.</p>
        <p>More information will be added here as plans are confirmed.</p>
        <a href="/">← Back to the festival homepage</a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
