---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import outputs from "../../amplify_outputs.json";
import "../styles/global.css";
import "../styles/sponsor-form.css";

const apiEndpoint =
  outputs.custom?.sponsorshipApi?.endpoint?.replace(/\/$/, "") ?? "";

const turnstileSiteKey =
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
---

<BaseLayout
  title="Sponsor a Barrel | Blewbury Beer Festival 2026"
  description="Sponsor a beer or cider barrel at Blewbury Beer Festival 2026 and help support local good causes."
>
  <Header />

  <main class="sponsor-form-page">
    <section class="sponsor-form-hero">
      <div class="container sponsor-form-hero-grid">
        <div>
          <p class="eyebrow">SUPPORT THE FESTIVAL</p>
          <h1>Sponsor a Barrel</h1>
          <p class="sponsor-form-intro">
            Barrel sponsorship is a simple way for local businesses to support
            Blewbury Beer Festival while helping us raise money for local good
            causes.
          </p>
        </div>

        <div class="barrel-mark" aria-hidden="true">
          <svg viewBox="0 0 120 120">
            <path d="M34 24c16-5 36-5 52 0" />
            <path d="M34 96c16 5 36 5 52 0" />
            <path d="M34 24c-5 18-5 54 0 72" />
            <path d="M86 24c5 18 5 54 0 72" />
            <path d="M29 42h62" />
            <path d="M27 78h66" />
            <path d="M58 42v36" />
            <circle cx="60" cy="60" r="5" />
          </svg>
        </div>
      </div>
    </section>

    <section class="sponsor-form-content">
      <div class="container sponsor-form-layout">
        <aside class="sponsor-form-benefits">
          <p class="sponsor-form-label">BARREL SPONSORSHIP</p>
          <h2>Support the festival and your community</h2>

          <p>
            Our barrel sponsors help make the festival possible and allow more
            of the money raised on the day to support local good causes.
          </p>

          <div class="sponsor-benefit">
            <span aria-hidden="true"></span>
            <p>Recognition on the festival website</p>
          </div>

          <div class="sponsor-benefit">
            <span aria-hidden="true"></span>
            <p>Recognition in the printed festival programme</p>
          </div>

          <div class="sponsor-benefit">
            <span aria-hidden="true"></span>
            <p>Recognition at the festival</p>
          </div>

          <p class="sponsor-form-small">
            Barrel allocations are arranged by the festival team, so you don't
            need to choose a particular beer or cider when enquiring.
          </p>
        </aside>

        <div class="sponsor-enquiry-panel">
          <p class="sponsor-form-label">GET INVOLVED</p>
          <h2>Tell us about your business</h2>

          <p class="sponsor-enquiry-intro">
            Complete the short form and the committee member looking after
            sponsorship will get back to you.
          </p>

          <form
            class="sponsorship-form"
            data-sponsorship-form
            data-api-endpoint={apiEndpoint}
          >
            <div class="form-honeypot" aria-hidden="true">
              <label>
                Website
                <input
                  type="text"
                  name="website"
                  tabindex="-1"
                  autocomplete="off"
                />
              </label>
            </div>

            <div class="form-field">
              <label for="businessName">Business name</label>
              <input
                id="businessName"
                name="businessName"
                type="text"
                maxlength="150"
                autocomplete="organization"
                required
              />
            </div>

            <div class="form-field">
              <label for="contactName">Your name</label>
              <input
                id="contactName"
                name="contactName"
                type="text"
                maxlength="150"
                autocomplete="name"
                required
              />
            </div>

            <div class="form-row">
              <div class="form-field">
                <label for="email">Email address</label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  maxlength="254"
                  autocomplete="email"
                  required
                />
              </div>

              <div class="form-field">
                <label for="phone">
                  Telephone
                  <span>optional</span>
                </label>
                <input
                  id="phone"
                  name="phone"
                  type="tel"
                  maxlength="80"
                  autocomplete="tel"
                />
              </div>
            </div>

            <div class="form-field">
              <label for="message">Message</label>
              <textarea
                id="message"
                name="message"
                rows="6"
                maxlength="3000"
                required
                placeholder="Tell us a little about your business or ask any questions about barrel sponsorship."
              ></textarea>
            </div>

            <div class="turnstile-wrap">
              {turnstileSiteKey ? (
                <div
                  class="cf-turnstile"
                  data-sitekey={turnstileSiteKey}
                  data-action="sponsorship"
                  data-theme="light"
                ></div>
              ) : (
                <p class="form-configuration-warning">
                  Verification is not configured.
                </p>
              )}
            </div>

            <p class="form-privacy-note">
              We’ll use the information you provide only to respond to your
              sponsorship enquiry.
            </p>

            <button class="sponsor-submit" type="submit" data-submit-button>
              Sponsor a Barrel
            </button>

            <div
              class="form-status"
              data-form-status
              role="status"
              aria-live="polite"
              hidden
            ></div>
          </form>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script
    is:inline
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    async
    defer
  ></script>

  <script is:inline>
    (() => {
      const form = document.querySelector("[data-sponsorship-form]");
      if (!form) return;

      const status = form.querySelector("[data-form-status]");
      const submit = form.querySelector("[data-submit-button]");
      const endpoint = form.dataset.apiEndpoint;

      const showStatus = (message, state) => {
        if (!status) return;
        status.hidden = false;
        status.textContent = message;
        status.dataset.state = state;
      };

      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        if (!endpoint) {
          showStatus("The enquiry service is temporarily unavailable.", "error");
          return;
        }

        const data = new FormData(form);
        const turnstileToken = data.get("cf-turnstile-response");

        if (!turnstileToken) {
          showStatus(
            "Please complete the verification before sending your enquiry.",
            "error"
          );
          return;
        }

        if (submit) {
          submit.disabled = true;
          submit.textContent = "Sending…";
        }

        showStatus("Sending your enquiry…", "working");

        const payload = {
          businessName: data.get("businessName"),
          contactName: data.get("contactName"),
          email: data.get("email"),
          phone: data.get("phone"),
          message: data.get("message"),
          website: data.get("website"),
          turnstileToken,
        };

        try {
          const response = await fetch(`${endpoint}/sponsorship-enquiry`, {
            method: "POST",
            headers: {
              "content-type": "application/json",
            },
            body: JSON.stringify(payload),
          });

          let result = {};

          try {
            result = await response.json();
          } catch {}

          if (!response.ok || !result.ok) {
            throw new Error(
              result.message ||
              "We couldn't send your enquiry. Please try again."
            );
          }

          form.reset();

          if (window.turnstile) {
            window.turnstile.reset();
          }

          showStatus(
            result.message ||
            "Thanks — your barrel sponsorship enquiry has been sent.",
            "success"
          );
        } catch (error) {
          showStatus(
            error instanceof Error
              ? error.message
              : "We couldn't send your enquiry. Please try again.",
            "error"
          );

          if (window.turnstile) {
            window.turnstile.reset();
          }
        } finally {
          if (submit) {
            submit.disabled = false;
            submit.textContent = "Sponsor a Barrel";
          }
        }
      });
    })();
  </script>
</BaseLayout>
