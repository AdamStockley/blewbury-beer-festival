---
import { festival } from "../data/festival";
---

<section class="hero hero-compact">
  <div class="hero-decoration hero-decoration-one"></div>
  <div class="hero-decoration hero-decoration-two"></div>

  <div class="container hero-inner hero-inner-compact">
    <div class="hero-topline">
      <span>{festival.location}</span>
      <span>Next festival date to be announced</span>
    </div>

    <div class="hero-main hero-main-compact">
      <p class="hero-kicker">BLEWBURY BEER FESTIVAL</p>

      <h1>
        Blewbury
        <span>Beer Festival</span>
      </h1>

      <p class="hero-description">
        Thank you for a brilliant day of great drinks, live music, good food
        and village spirit — all in support of good causes.
      </p>

      <div class="button-row">
        <a class="button button-light" href="/news">
          Festival news
        </a>

        <a class="text-link-light" href="/drinks">
          Look back at the drinks <span>→</span>
        </a>
      </div>
    </div>

    <div class="hero-bottom">
      <p>{festival.strapline}</p>
    </div>
  </div>
</section>
