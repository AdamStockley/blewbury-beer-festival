---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import "../styles/food.css";
---

<BaseLayout
  title="Food | Blewbury Beer Festival 2026"
  description="Burgers, bratwurst and vegetarian three-bean chilli nachos from Blewbury School PTA at Blewbury Beer Festival 2026."
>
  <Header />

  <main class="food-page">
    <section class="food-hero">
      <div class="container food-hero-grid">
        <div>
          <p class="eyebrow">2026 FOOD</p>
          <h1>Festival Food</h1>
          <p class="food-hero-copy">
            Great beer deserves great food. Blewbury School PTA will be serving
            burgers, bratwurst and three-bean chilli nachos, with main food
            service from 2pm until approximately 5pm, or while stocks last.
          </p>
        </div>

        <div class="food-hero-icon" aria-hidden="true">
          <svg viewBox="0 0 120 120">
            <path d="M36 18v34" />
            <path d="M28 18v24c0 8 4 12 8 12s8-4 8-12V18" />
            <path d="M36 52v50" />
            <path d="M76 18v84" />
            <path d="M76 18c12 9 16 24 16 38H76" />
          </svg>
        </div>
      </div>
    </section>

    <section class="food-content">
      <div class="container">
        <div class="food-info-grid">
          <article class="food-info-card">
            <div class="food-card-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="M5 15h14" />
                <path d="M7 15a5 5 0 0 1 10 0" />
                <path d="M12 10V7" />
                <path d="M10 7h4" />
                <path d="M4 18h16" />
              </svg>
            </div>

            <div>
              <p class="food-card-label">AT THE FESTIVAL</p>
              <h2>Main food served from 2pm</h2>
              <ul class="food-feature-list">
                <li>Burgers</li>
                <li>Bratwurst</li>
                <li>Three-bean chilli nachos (vegetarian)</li>
                <li>Soft drinks and snacks</li>
              </ul>
            </div>
          </article>

          <article class="food-supplier-card food-supplier-card--with-logo">
            <img
              class="food-school-logo"
              src="/images/food/blewbury-primary-school-logo.png"
              alt="Blewbury C of E Primary School"
              width="591"
              height="591"
            />

            <div class="food-supplier-copy">
              <p class="food-card-label">2026 FOOD TEAM</p>
              <h2>Blewbury School PTA</h2>
              <p>
                The PTA will be running the kitchen this year. Main food service
                will continue until approximately 5pm, or while stocks last.
              </p>
              <p>
                Blewbury School PTA is a registered charity run by parents,
                guardians and school staff. Its events bring the school community
                together and raise funds to support every child at the school —
                so you can do good just by having a burger.
              </p>

              <a
                href="https://www.blewbury.oxon.sch.uk/page/?title=PTA&amp;pid=49"
                target="_blank"
                rel="noopener noreferrer"
                class="food-link"
              >
                Find out more about Blewbury School PTA ↗
              </a>
            </div>
          </article>
        </div>

        <div class="food-planning-note">
          <div class="food-card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11Z" />
              <circle cx="12" cy="10" r="2.5" />
            </svg>
          </div>

          <div>
            <p class="food-card-label">PLANNING YOUR VISIT?</p>
            <p>
              Soft drinks and snacks may remain available later, subject to
              volunteer availability.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
