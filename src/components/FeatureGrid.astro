---
const features = [
  {
    kicker: "LIVE MUSIC",
    title: "Who's playing?",
    text: "See the confirmed performers and how the afternoon and evening programme is taking shape.",
    href: "/entertainment",
    link: "See the line-up",
  },
  {
    kicker: "FOOD",
    title: "What's cooking?",
    text: "Blewbury School PTA will be serving burgers, bratwurst and vegetarian three-bean chilli nachos from 2pm.",
    href: "/food",
    link: "See the food",
  },
  {
    kicker: "BARREL SPONSORS",
    title: "Meet our supporters.",
    text: "Meet the local businesses sponsoring our beer and cider barrels — and find out how your business can get involved.",
    href: "/sponsors",
    link: "Meet our sponsors",
  },
];
---

<section class="home-features">
  <div class="container">
    <div class="home-feature-grid">
      {features.map((feature) => (
        <a class="home-feature-card" href={feature.href}>
          <p class="eyebrow">{feature.kicker}</p>
          <h2>{feature.title}</h2>
          <p>{feature.text}</p>
          <span>{feature.link} →</span>
        </a>
      ))}
    </div>
  </div>
</section>
