---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---

<BaseLayout title="Food | Blewbury Beer Festival 2026">
  <Header />

  <main class="placeholder">
    <div class="container">
      <div class="placeholder-box">
        <p class="eyebrow">2026 Festival</p>
        <h1>Food</h1>
        <p>Details of food available at the 2026 festival are still being finalised.</p>
        <p>More information will be added here as plans are confirmed.</p>
        <a href="/">← Back to the festival homepage</a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
