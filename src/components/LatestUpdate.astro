---
const { latest } = Astro.props;

const published = latest
  ? latest.data.published.toLocaleDateString("en-GB", {
      day: "numeric",
      month: "long",
      year: "numeric",
    })
  : null;
---

<section class="home-latest">
  <div class="container home-latest-grid">
    <div>
      <p class="eyebrow">LATEST</p>
      <h2>Festival news</h2>
      <a class="home-news-all-link" href="/news">Read all news →</a>
    </div>

    {latest ? (
      <article class="home-latest-card">
        <div class="news-meta">{published}</div>
        <h3>
          <a href={`/news/${latest.id}`}>{latest.data.title}</a>
        </h3>
        <p>{latest.data.summary}</p>
        <a class="home-news-read-link" href={`/news/${latest.id}`}>
          Read article →
        </a>
      </article>
    ) : (
      <div class="home-latest-card">
        <p>More festival news coming soon.</p>
      </div>
    )}
  </div>
</section>
