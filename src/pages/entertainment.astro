---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---

<BaseLayout title="Live Entertainment | Blewbury Beer Festival 2026">
  <Header />

  <main class="placeholder">
    <div class="container">
      <div class="placeholder-box">
        <p class="eyebrow">2026 Festival</p>
        <h1>Live Entertainment</h1>
        <p>The 2026 entertainment programme is currently being put together. Performers and timings will appear here as they're announced.</p>
        <p>More information will be added here as plans are confirmed.</p>
        <a href="/">← Back to the festival homepage</a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
